AArch64 "Compound Arm + TSO"

catdep                       (* dependencies are computed by aarch64deps.cat *)
include "prelude.cat"
include "arm-ppo.cat"
include "tso-ppo.cat"
let MARK = ISB & ~range(po)                   (* a thread starting with ISB runs TSO *)
let TSO  = MARK | range([MARK]; po)
let ARM  = ~TSO
let ppo = [ARM]; arm-ppo-all; [ARM] | [TSO]; tso-ppo-all; [TSO]
include "axioms.cat"
