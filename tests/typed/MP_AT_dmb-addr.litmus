AArch64 MP_AT_dmb-addr
{ int64_t x; int64_t y; int64_t z; int64_t w; 0:X10=x; 0:X11=y; int64_t 0:X12=1; int64_t 0:X13=2; 0:X14=z; 0:X15=w; 1:X10=x; 1:X11=y; int64_t 1:X12=1; int64_t 1:X13=2; 1:X14=z; 1:X15=w; int64_t 1:X0; int64_t 1:X1; int64_t 1:X5; }
 P0             | P1 ;
 STR X12,[X10]  | LDR X0,[X11] ;
 DMB ISH        | EOR X5,X0,X0 ;
 STR X12,[X11]  | LDR X1,[X10,X5] ;
exists (1:X0=1 /\ 1:X1=0)
